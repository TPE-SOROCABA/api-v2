DATABASE_URL=postgresql://tpe:tpe@localhost:5433/tpedigital?schema=public
PORT=3000
NODE_ENV=development

# AWS / S3 — vazio por padrão.
# Rotas de upload de PDF/foto e URLs do CloudFront não funcionarão até preencher.
# Copie os valores reais de .env.hmg ou Portainer.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
CLOUDFRONT_PETITION_URL=

# Firebase Admin SDK — vazio por padrão.
# Autenticação e notificações Firebase podem falhar até preencher.
# Gere uma service account no console do Firebase e cole aqui.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
