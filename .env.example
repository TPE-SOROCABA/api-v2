# API v2 — environment template
# Copy to `.env` (dev), `.env.hmg` (acceptance) or set in your deploy platform.
# Never commit the real values.

# Database
DATABASE_URL=postgresql://user:password@host:5432/db?schema=public

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# URLs das filas EXISTENTES da legacy, do mesmo ambiente do banco.
# BFF só publica; consumidores, DLQ, crons e recursos continuam na legacy.
WHATSAPP_MESSAGE_QUEUE=
WHATSAPP_MESSAGE_DLQ=
# Opcional: endpoint do ElasticMQ para testes locais. Nunca apontar para AWS em testes.
SQS_ENDPOINT=

# App
NODE_ENV=development
PORT=3000

# CloudFront (signed petition URLs)
CLOUDFRONT_PETITION_URL=

# Envio de designação (POST /designations/:id/send) — Fase 5
# Os defaults são os mesmos da legacy (api/src/services/SendAssignmentDesignation.ts
# e api/src/services/ShortLinkService.ts). O importante é que API_URL aponte para
# a BASE DA LEGACY por ambiente, porque o link "MINHA" continua levando para
# /public/start/:id, que ainda mora lá:
#   hmg  -> https://api.tpedigital.com.br/hmg
#   prod -> https://api.tpedigital.com.br/prod
FRONTEND_URL=https://app.tpedigital.com.br
API_URL=https://api.tpedigital.com.br/dev
SHORT_LINK_DOMAIN=https://go.tpedigital.com.br

# Z-API (somente LEITURA, para a aba WhatsApp da tela de Coordenação).
# O BFF não envia mensagem por aqui: quem publica é a fila e quem entrega é a
# legacy. Nomes idênticos aos da legacy de propósito, para copiar o valor do
# Portainer sem renomear. Z_API_URL já inclui "/instances" no fim.
#   https://<z-api-url>/<INSTANCE_ID>/token/<INSTANCE_TOKEN>/status
#   https://<z-api-url>/<INSTANCE_ID>/token/<INSTANCE_TOKEN>/qr-code/image
Z_API_URL=https://api.z-api.io/instances
INSTANCE_ID=
INSTANCE_TOKEN=
# Header "Client-Token" das chamadas ao Z-API.
USER_TOKEN_ID=
